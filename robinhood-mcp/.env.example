ROBINHOOD_USERNAME=your-robinhood-email@example.com
ROBINHOOD_PASSWORD=your-robinhood-password

# Optional but strongly recommended: the base32 TOTP secret from setting up
# an authenticator app (Google Authenticator, Authy, etc.) as your Robinhood
# 2FA method. When set, MFA codes are generated automatically on login.
# Without it, logins that require MFA will fail with an error asking for one.
ROBINHOOD_MFA_SECRET=
