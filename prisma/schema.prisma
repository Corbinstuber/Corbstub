generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── PRODUCT CATALOG (admin-managed) ─────────────────────────────────────────

model SectionDefinition {
  id         String   @id @default(uuid())
  code       String   @unique
  label      String
  category   String   // fan | coil | filter | mixing | recovery | misc
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  config     Json     @default("{}") // { allowMultiple, minQty, maxQty, defaultQty }
  uiMeta     Json     @default("{}") // { icon, color, description }
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  options      SectionOptionDefinition[]
  unitSections UnitSection[]

  @@map("section_definitions")
}

model SectionOptionDefinition {
  id               String   @id @default(uuid())
  sectionDefId     String
  code             String
  label            String
  inputType        String   // select | number | boolean | multi_select | text
  sortOrder        Int      @default(0)
  isRequired       Boolean  @default(false)
  defaultValue     String?
  unitOfMeasure    String?
  helpText         String?
  config           Json     @default("{}") // { min, max, step } for numeric
  displayCondition Json?

  sectionDef SectionDefinition       @relation(fields: [sectionDefId], references: [id], onDelete: Cascade)
  choices    SectionOptionChoice[]
  selections UnitSectionOption[]

  @@unique([sectionDefId, code])
  @@map("section_option_definitions")
}

model SectionOptionChoice {
  id          String  @id @default(uuid())
  optionDefId String
  value       String
  label       String
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)
  metadata    Json    @default("{}") // { priceAdder, weightLbs, leadTimeDays }

  optionDef SectionOptionDefinition @relation(fields: [optionDefId], references: [id], onDelete: Cascade)

  @@map("section_option_choices")
}

model ValidationRule {
  id           String  @id @default(uuid())
  code         String  @unique
  label        String
  scope        String  // unit | section | option
  ruleType     String  // requires | excludes | range_check | custom_fn
  condition    Json
  assertion    Json
  errorMessage String
  severity     String  @default("error") // error | warning
  isActive     Boolean @default(true)

  @@map("validation_rules")
}

model CalculationDefinition {
  id           String   @id @default(uuid())
  code         String   @unique
  label        String
  category     String   // psychrometrics | fan | coil | filter
  inputSchema  Json     @default("{}")
  outputSchema Json     @default("{}")
  dependsOn    String[] @default([])
  isActive     Boolean  @default(true)
  notes        String?

  results UnitCalculation[]

  @@map("calculation_definitions")
}

// ─── USERS ────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("engineer") // engineer | admin
  createdAt DateTime @default(now())

  projects  Project[]
  jobs      Job[]
  auditLogs AuditLog[]
  accounts  Account[]
  sessions  Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── JOB DATA ─────────────────────────────────────────────────────────────────

model Project {
  id              String   @id @default(uuid())
  name            String
  customerName    String?
  customerContact String?
  address         String?
  notes           String?
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  createdBy User  @relation(fields: [createdById], references: [id])
  jobs      Job[]

  @@map("projects")
}

model Job {
  id             String   @id @default(uuid())
  projectId      String
  jobNumber      String   @unique
  revision       Int      @default(1)
  status         String   @default("draft") // draft | in_review | approved | archived
  name           String
  notes          String?
  siteConditions Json     @default("{}")
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdById], references: [id])
  units     Unit[]

  @@map("jobs")
}

model Unit {
  id               String   @id @default(uuid())
  jobId            String
  tag              String
  service          String?
  designAirflowCfm Decimal?
  casingWidthIn    Decimal?
  casingHeightIn   Decimal?
  orientation      String   @default("horizontal")
  notes            String?
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  job          Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  sections     UnitSection[]
  calculations UnitCalculation[]

  @@map("units")
}

model UnitSection {
  id           String  @id @default(uuid())
  unitId       String
  sectionDefId String
  position     Int
  quantity     Int     @default(1)
  isActive     Boolean @default(true)
  notes        String?

  unit       Unit                    @relation(fields: [unitId], references: [id], onDelete: Cascade)
  sectionDef SectionDefinition       @relation(fields: [sectionDefId], references: [id])
  options    UnitSectionOption[]

  @@map("unit_sections")
}

model UnitSectionOption {
  id            String @id @default(uuid())
  unitSectionId String
  optionDefId   String
  value         String

  unitSection UnitSection             @relation(fields: [unitSectionId], references: [id], onDelete: Cascade)
  optionDef   SectionOptionDefinition @relation(fields: [optionDefId], references: [id])

  @@unique([unitSectionId, optionDefId])
  @@map("unit_section_options")
}

model UnitCalculation {
  id           String   @id @default(uuid())
  unitId       String
  calcDefCode  String
  inputs       Json     @default("{}")
  outputs      Json     @default("{}")
  warnings     String[] @default([])
  calculatedAt DateTime @default(now())
  calcVersion  String   @default("1.0.0")
  isStale      Boolean  @default(false)

  unit    Unit                  @relation(fields: [unitId], references: [id], onDelete: Cascade)
  calcDef CalculationDefinition @relation(fields: [calcDefCode], references: [code])

  @@unique([unitId, calcDefCode])
  @@map("unit_calculations")
}

// ─── AUDIT ────────────────────────────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(uuid())
  entityType  String
  entityId    String
  action      String   // create | update | delete
  changedById String?
  changedAt   DateTime @default(now())
  beforeState Json?
  afterState  Json?

  changedBy User? @relation(fields: [changedById], references: [id])

  @@map("audit_log")
}
